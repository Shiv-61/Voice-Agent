# Sarvam AI API Subscription Key (STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM Provider Configuration (OpenRouter in production / Ollama locally)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_MAX_TOKENS=350
LLM_TEMPERATURE=0.2

# PostgreSQL Database Connection String (falls back to local SQLite if unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/university_agent

# MongoDB Atlas Configuration for Call Transcripts & History
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.llp7ahv.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=voice_agent

# Server & Network Configuration (Render sets PORT automatically)
HOST=0.0.0.0
PORT=8765
CORS_ORIGINS=*

# ChromaDB Vector Store Directory (defaults to ./db/chroma_db)
# Set to /var/data/chroma_db if using an attached Render persistent disk
CHROMA_PERSIST_DIR=
