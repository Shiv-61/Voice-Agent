# Sarvam AI API Subscription Key (STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# OpenRouter API Key & Model Configuration
OPENROUTER_API_KEY=sk-or-v1-...
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# PostgreSQL Database Connection String (falls back to local SQLite if unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/university_agent
