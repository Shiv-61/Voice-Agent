## 2. Telephony & Phone Assignment Flow

```mermaid
flowchart LR
    classDef admin fill:#fff8e1,stroke:#ff8f00,stroke-width:2px
    classDef system fill:#e8eaf6,stroke:#283593,stroke-width:1.5px
    classDef tel fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px

    Admin([Admin User]):::admin
    Dashboard["Web Dashboard"]:::admin

    subgraph PhoneMgmt ["Phone Number Management"]
        NumberPool[("Number Pool DB\n+91-XXXX-1\n+91-XXXX-2\n+91-XXXX-3")]
        AgentMap["Agent ↔ Number\nMapping Table"]
        ProviderAPI["Telephony Provider\nAPI (Twilio / Exotel)"]
    end
    class NumberPool,AgentMap,ProviderAPI system

    subgraph CallRouting ["Inbound Call Routing"]
        InboundCall(["Incoming Call\nto +91-XXXX-1"])
        Lookup["Lookup Agent\nby Called Number"]
        LoadConfig["Load Agent Config\n(persona, language,\nRAG collection)"]
        SpawnSession["Spawn Voice\nPipeline Session"]
    end
    class InboundCall,Lookup,LoadConfig,SpawnSession tel

    Admin -- "Configure agent" --> Dashboard
    Dashboard -- "Assign phone number\nto agent" --> AgentMap
    Dashboard -- "Buy / release\nnumber" --> ProviderAPI
    ProviderAPI -- "Register number" --> NumberPool

    InboundCall --> Lookup
    Lookup -- "Query" --> AgentMap
    AgentMap -- "Agent ID +\nconfig ref" --> LoadConfig
    LoadConfig --> SpawnSession
```

