## 6. Admin Dashboard — Feature Map

```mermaid
flowchart LR
    classDef page fill:#e8eaf6,stroke:#283593,stroke-width:1.5px
    classDef action fill:#fff3e0,stroke:#e65100,stroke-width:1.5px
    classDef data fill:#f1f8e9,stroke:#33691e,stroke-width:1.5px

    subgraph Dashboard ["Admin Web Dashboard"]
        direction TB

        subgraph AgentMgmt ["Agent Management"]
            CreateAgent["Create Agent\n(name, persona prompt)"]
            AssignPhone["Assign Phone Number"]
            SetLang["Set Supported\nLanguages"]
            SetVoice["Select Voice\n(Kokoro / ElevenLabs preset)"]
            SetRAG["Link RAG Collection"]
        end
        class CreateAgent,AssignPhone,SetLang,SetVoice,SetRAG page

        subgraph DocMgmt ["Document Management"]
            UploadDoc["Upload Documents\n(PDF, DOCX, TXT)"]
            ViewDocs["View Indexed\nDocuments"]
            DeleteDoc["Delete / Re-index\nDocument"]
            IngestionStatus["Ingestion Status\n& Progress"]
        end
        class UploadDoc,ViewDocs,DeleteDoc,IngestionStatus action

        subgraph CallAnalytics ["Call Analytics"]
            CallHistory["Call History\n& Recordings"]
            Transcripts["Full Transcripts\n(with lang tags)"]
            Dispositions["Call Dispositions\n& Outcomes"]
            Metrics["Metrics Dashboard\n(calls/day, avg duration,\nlang distribution)"]
        end
        class CallHistory,Transcripts,Dispositions,Metrics data
    end
```

