# Voice Agent — Architecture Diagrams

---

## 1. High-Level System Architecture

```mermaid
flowchart TB
    classDef telephony fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
    classDef gateway fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1
    classDef stt fill:#fff3e0,stroke:#e65100,stroke-width:1.5px,color:#bf360c
    classDef llm fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1.5px,color:#4a148c
    classDef rag fill:#fce4ec,stroke:#c62828,stroke-width:1.5px,color:#b71c1c
    classDef tts fill:#e0f7fa,stroke:#00695c,stroke-width:1.5px,color:#004d40
    classDef storage fill:#f5f5f5,stroke:#616161,stroke-dasharray:5 5,color:#424242
    classDef web fill:#fffde7,stroke:#f9a825,stroke-width:2px,color:#f57f17
    classDef cloud fill:#eceff1,stroke:#455a64,stroke-width:2px,color:#263238
    classDef queue fill:#fbe9e7,stroke:#d84315,stroke-width:1.5px,color:#bf360c

    subgraph Callers ["Callers (100+ / day)"]
        Caller1([Caller A — Hindi])
        Caller2([Caller B — Gujarati])
        Caller3([Caller C — English])
    end
    class Caller1,Caller2,Caller3 telephony

    subgraph Telephony ["Telephony Layer"]
        Provider["Telephony Provider\n(Twilio / Exotel / Plivo)"]
        PhonePool["Phone Number Pool\n& Agent-Number Mapping"]
        SIPGateway["SIP / WebSocket\nMedia Gateway"]
    end
    class Provider,PhonePool,SIPGateway gateway

    subgraph Cloud ["Cloud Deployment (AWS / GCP)"]

        subgraph Pipeline ["Voice Agent Pipeline"]
            direction TB

            subgraph STT_Layer ["STT — Multi-language"]
                LangDetect["Language Detector\n(auto / caller-config)"]
                WhisperLarge["faster-whisper\n(distil-large-v3)\nEN · HI · GU · 99+ langs"]
            end
            class LangDetect,WhisperLarge stt

            subgraph LLM_Layer ["LLM + RAG Engine"]
                LLMRouter["LLM Router"]
                Qwen["Qwen 2.5 : 3B\n(via Ollama)"]
                RAGAgent["RAG Agent\n(LangChain / LlamaIndex)"]
                TransLayer["Response Translator\n(LLM-based EN→GU/HI)"]
            end
            class LLMRouter,Qwen,RAGAgent,TransLayer llm

            subgraph TTS_Layer ["TTS — Multi-language"]
                TTSRouter["TTS Router"]
                Kokoro["Kokoro-82M\n(English)"]
                ElevenLabs["ElevenLabs API\n(Hindi · Gujarati)"]
            end
            class TTSRouter,Kokoro,ElevenLabs tts
        end

        subgraph RAG_Infra ["RAG Infrastructure"]
            VectorDB[("Vector Store\n(Qdrant / Pinecone /\nChromaDB)")]
            Embeddings["Embedding Model\n(all-MiniLM /\nmultilingual-e5)"]
            Chunker["Document Chunker\n& Preprocessor"]
        end
        class VectorDB,Embeddings,Chunker rag

        subgraph WebApp ["Admin Web Dashboard"]
            DocUpload["Document Upload\n(EN · GU PDFs, DOCX)"]
            AgentConfig["Agent Config Panel\n(phone, voice, persona,\nlanguage)"]
            Analytics["Call Analytics &\nTranscript Viewer"]
            IngestionTrigger["Ingestion Trigger\n(webhook / on-upload)"]
        end
        class DocUpload,AgentConfig,Analytics,IngestionTrigger web

        subgraph Infra ["Infrastructure"]
            TaskQueue["Task Queue\n(Celery + Redis)"]
            ObjStore[("Object Storage\n(S3 / GCS)")]
            CallLogs[("Call Logs DB\n(PostgreSQL)")]
            Cache["Response Cache\n(Redis)"]
        end
        class TaskQueue,ObjStore,CallLogs,Cache storage
    end
    class Cloud cloud

    %% ===== Connections =====

    Caller1 & Caller2 & Caller3 -- "PSTN / VoIP" --> Provider
    Provider -- "Assign Number" --> PhonePool
    Provider -- "Audio Stream" --> SIPGateway

    SIPGateway -- "Raw Audio\n(16kHz PCM)" --> LangDetect
    LangDetect -- "Detected Lang" --> WhisperLarge
    WhisperLarge -- "Transcribed Text +\nLanguage Tag" --> LLMRouter

    LLMRouter -- "Query + Context" --> RAGAgent
    RAGAgent -- "Retrieve chunks" --> VectorDB
    RAGAgent -- "Augmented prompt" --> Qwen
    Qwen -- "EN response" --> TransLayer
    TransLayer -- "GU/HI response\n(if needed)" --> TTSRouter

    TTSRouter -- "English text" --> Kokoro
    TTSRouter -- "Hindi/Gujarati text" --> ElevenLabs
    Kokoro & ElevenLabs -- "Synthesized Audio" --> SIPGateway
    SIPGateway -- "Audio Response" --> Provider

    %% Document Ingestion
    DocUpload -- "Upload files" --> ObjStore
    DocUpload -- "Fire trigger" --> IngestionTrigger
    IngestionTrigger -- "Enqueue job" --> TaskQueue
    TaskQueue -- "Process" --> Chunker
    Chunker -- "Text chunks" --> Embeddings
    Embeddings -- "Vectors" --> VectorDB

    %% Logging & Analytics
    SIPGateway -. "Call metadata" .-> CallLogs
    WhisperLarge -. "Transcripts" .-> CallLogs
    Qwen -. "LLM responses" .-> CallLogs
    CallLogs -. "Dashboard data" .-> Analytics
```

